# Multi-stage build for Radiant server
FROM --platform=$BUILDPLATFORM python:3.12-slim as base

ARG TARGETPLATFORM
ARG BUILDPLATFORM

WORKDIR /app

# Install Poetry
RUN pip install poetry==2.2.1

# Copy dependency files
COPY server/pyproject.toml server/poetry.lock ./

# Install dependencies
RUN poetry config virtualenvs.create false && \
    poetry install --no-dev --no-root --no-interaction

# Runtime stage
FROM python:3.12-slim as runtime

WORKDIR /app

# Copy installed packages from base
COPY --from=base /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=base /usr/local/bin /usr/local/bin

# Copy application code
COPY server/src ./src

# Create non-root user
RUN useradd -m -u 1000 radiant && \
    chown -R radiant:radiant /app

USER radiant

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8000/health')"

CMD ["uvicorn", "radiant_server.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
